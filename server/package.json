{
  "name": "@momentum/server",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/core/db/migrate-cli.ts",
    "db:seed": "tsx src/core/db/seed.ts"
  },
  "dependencies": {
    "@momentum/shared": "*",
    "@electric-sql/pglite": "^0.3.0",
    "better-auth": "^1.3.0",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "luxon": "^3.7.2",
    "nodemailer": "^7.0.13",
    "pg": "^8.16.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.5",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.4"
  }
}
