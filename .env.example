# Copy to .env and adjust. Never commit .env.

# --- Core ---------------------------------------------------------------
# Public origin of the web app. In dev the Vite server proxies /api to the API.
APP_URL=http://localhost:5173
PORT=3001

# Session signing secret (required in production). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# 32-byte base64 key for encrypting integration tokens at rest (defaults to a key derived from BETTER_AUTH_SECRET).
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Database -------------------------------------------------------------
# PostgreSQL connection string. Leave empty to use the embedded PGlite database in server/.data/pglite.
DATABASE_URL=
# PGLITE_DIR=./.data/pglite

# --- Integrations (optional) ------------------------------------------------
# GitHub OAuth app — callback URL: {APP_URL}/api/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# YouTube Data API v3 key for playlist import (manual lesson entry works without it)
YOUTUBE_API_KEY=
# LeetCode uses an unofficial endpoint; set to false to disable it.
LEETCODE_ENABLED=true

# Background jobs (reminders, integration sync)
JOBS_ENABLED=true
