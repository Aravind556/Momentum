# Copy to .env and adjust. Never commit .env.

# --- Core ---------------------------------------------------------------
# Public origin of the web app. In dev the Vite server proxies /api to the API.
APP_URL=http://localhost:5173
PORT=3001

# Session signing secret (required in production). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Database -------------------------------------------------------------
# PostgreSQL connection string. Leave empty to use the embedded PGlite database in server/.data/pglite.
# Supabase: Project Settings → Database → Connection string → "Session pooler" (port 5432), e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# TLS is enabled automatically for Supabase URLs.
DATABASE_URL=
# PGLITE_DIR=./.data/pglite

# --- Browser notifications (reminders) ----------------------------------------
# Generate once with: npx web-push generate-vapid-keys   (keep them stable — changing them
# invalidates every browser's subscription). In development a pair is created automatically.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Email (final reminder of the day) -----------------------------------------
# Any SMTP server works (Gmail with an app password, Brevo, your college SMTP...).
# Without SMTP_HOST, emails are printed to the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cadence <no-reply@example.com>"

# --- Platforms (optional) ----------------------------------------------------
# LeetCode uses an unofficial endpoint; set to false to disable it.
LEETCODE_ENABLED=true
# YouTube Data API v3 key, only needed to import a playlist into a roadmap.
YOUTUBE_API_KEY=

# Background jobs (reminders, daily planning, light background sync)
JOBS_ENABLED=true
